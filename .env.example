# --- Wajib untuk JWT sesi (mock maupun verifikasi middleware) ---
# Harus sama dengan JWT_SECRET di backend Go kalau AUTH_MODE=http.
# Minimal 16 karakter. Jangan commit nilai produksi.
AUTH_SECRET=ganti-dengan-string-panjang-min-16

# mock = dummy env (default). http = backend nyata (wajib API_BASE_URL).
AUTH_MODE=mock

# Base URL backend tanpa slash akhir (hanya jika AUTH_MODE=http).
# API_BASE_URL=https://api.parkin-palu.example

# --- Kredensial dummy (adapter mock) ---
DUMMY_ADMIN_EMAIL=admin@example.com
DUMMY_ADMIN_PASSWORD=admin123

# Opsional: akun kedua untuk simulasi 403 (role tidak diizinkan di dashboard).
DUMMY_BLOCKED_EMAIL=user@example.com
DUMMY_BLOCKED_PASSWORD=user123
