# --- Wajib untuk JWT sesi ---
# Harus sama dengan JWT_SECRET di backend Go.
# Minimal 16 karakter. Jangan commit nilai produksi.
AUTH_SECRET=ganti-dengan-string-panjang-min-16

# Base URL backend tanpa slash akhir.
API_BASE_URL=https://api.parkin-palu.example

# URL publik aplikasi web (untuk token refresh & callback).
# Tanpa slash akhir. Harus bisa diakses dari browser user.
NEXT_PUBLIC_APP_URL=https://parkin.example.com
